{
  "$schema": "https://design-tokens.github.io/format",
  "theme": "Graphite & Ice Blue",
  "colors": {
    "background": "#09090B",
    "surface": "#18181B",
    "surfaceElevated": "#202024",
    "border": "#27272A",
    "borderStrong": "#3F3F46",
    "textPrimary": "#F4F4F5",
    "textSecondary": "#A1A1AA",
    "textMuted": "#9898A2",
    "accent": "#38BDF8",
    "accentHover": "#7DD3FC",
    "accentMuted": "rgba(56, 189, 248, 0.12)",
    "onAccent": "#09090B",
    "onPrimaryButton": "#09090B",
    "primaryButton": "#F4F4F5",
    "success": "#34D399"
  },
  "typography": {
    "sans": "Geist, Inter, system-ui, sans-serif",
    "mono": "Geist Mono, JetBrains Mono, ui-monospace, monospace",
    "sizes": {
      "hero": 56,
      "h2": 32,
      "h3": 20,
      "body": 16,
      "small": 14,
      "mono": 12
    }
  },
  "spacing": [4, 8, 16, 24, 32, 48, 64, 96],
  "radii": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "full": 9999
  },
  "layout": {
    "maxWidth": 1200,
    "gutter": 24
  }
}
