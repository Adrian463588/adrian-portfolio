# ==============================================================================
# Ask Adrian AI Portfolio Assistant — Server-Side Environment Variables
# Copy to `.env.local` for local development. NEVER commit real secrets.
# Store production values as Vercel Sensitive Environment Variables.
# ==============================================================================

# Provider Enable Flags
GROQ_ENABLED=true
GEMINI_ENABLED=false
OPENROUTER_ENABLED=true

# Verified Free-Tier / Free-Variant Models
# Groq: qwen/qwen3.8-27b (verified free-tier compatible)
# Gemini: gemini-3.1-flash-lite-preview (enable GEMINI_ENABLED=true only after compliance review)
# OpenRouter: openrouter/free (free router only; paid fallback permanently blocked)
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.1-flash-lite-preview
OPENROUTER_MODEL=openrouter/free

# Groq API Key Slots (Primary) — set real values ONLY in .env.local or Vercel Sensitive Env
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
GROQ_API_KEY_3=your_groq_api_key_3

# Google Gemini API Key Slots (Fallback 1 — gated by GEMINI_ENABLED)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3

# OpenRouter API Key Slots (Fallback 2 — Free Models Only)
OPENROUTER_API_KEY_1=your_openrouter_api_key_1
OPENROUTER_API_KEY_2=your_openrouter_api_key_2
OPENROUTER_API_KEY_3=your_openrouter_api_key_3

# Operational Limits & Safeguards
CHAT_FAQ_FIRST=true
CHAT_FREE_ONLY=true
CHAT_ALLOW_MULTI_ACCOUNT_ROTATION=true
CHAT_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_DAY=20
CHAT_GLOBAL_DAILY_ATTEMPTS=100
CHAT_MAX_OUTPUT_TOKENS=512
CHAT_PROVIDER_TIMEOUT_MS=7000
CHAT_TOTAL_DEADLINE_MS=25000

# Optional Distributed Limiter (Upstash Redis REST — recommended for multi-instance Vercel scale)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.example.com
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
CHAT_REQUIRE_DISTRIBUTED_LIMITER=false

# Optional Cloudflare Turnstile Challenge (off unless abuse mitigation requires it)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
